<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="meshes_dir" value="package://hexa_description/meshes" />

    <link name="base_link" />

    <!-- Body -->
    <link name="body_link">
        <visual>
            <geometry>
                <mesh filename="${meshes_dir}/body.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0 0 22.65e-3" rpy="0 0 ${-pi / 2}" />
            <material name="grey" />
        </visual>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_link" />
        <child link="body_link" />
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Legs -->
    <xacro:macro name="coxa_link" params="link_name">
        <link name="${link_name}">
             <visual>
                <geometry>
                    <mesh filename="${meshes_dir}/coxa.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <origin xyz="-5e-3 17.2e-3 -17.2e-3" rpy="${pi / 2} ${-pi / 2} 0" />
            <material name="grey" />
        </visual>
        </link>
    </xacro:macro>

    <xacro:macro name="tibia_link" params="link_name">
        <link name="${link_name}">
             <visual>
                <geometry>
                    <mesh filename="${meshes_dir}/tibia.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <origin xyz="27.875e-3 0 0" rpy="0 ${pi / 2} 0" />
            <material name="grey" />
        </visual>
        </link>
    </xacro:macro>

    <xacro:macro name="femur_link" params="link_name">
        <link name="${link_name}">
             <visual>
                <geometry>
                    <mesh filename="${meshes_dir}/femur.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <origin xyz="-17.2e-3 0 0" rpy="0 ${pi / 2} 0" />
            <material name="grey" />
        </visual>
        </link>
    </xacro:macro>

    <xacro:macro name="endpoint_link" params="link_name">
        <link name="${link_name}">
             <visual>
                <geometry>
                    <box size="20e-3 20e-3 20e-3" />
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="red" />
        </visual>
        </link>
    </xacro:macro>

    <xacro:macro name="leg" params="index angle">
         <xacro:coxa_link link_name="coxa_${index}_link"/>
         <xacro:tibia_link link_name="tibia_${index}_link"/>
         <xacro:femur_link link_name="femur_${index}_link"/>
         <xacro:endpoint_link link_name="endpoint_${index}_link"/>

         <joint name="body_to_coxa_${index}_joint" type="revolute">
            <xacro:property name="body_radius" value="140.787e-3" />

            <parent link="body_link" />
            <child link="coxa_${index}_link" />
            <origin xyz="${body_radius * cos(angle)} ${-body_radius * sin(angle)} 0" rpy="${angle} ${pi / 2} 0"/>
            <limit lower="${-pi / 2}" upper="${pi / 2}" effort="2.941995" velocity="${2 * pi / 1.2}"/>
         </joint>

         <joint name="coxa_to_tibia_${index}_joint" type="revolute">

            <parent link="coxa_${index}_link" />
            <child link="tibia_${index}_link" />
            <origin xyz="-46.875e-3 0 57.25e-3" rpy="0 0 ${pi / 2}"/>
            <limit lower="${-pi / 4}" upper="${pi / 2}" effort="2.941995" velocity="${2 * pi / 1.2}"/>
         </joint>

         <joint name="tibia_to_femur_${index}_joint" type="revolute">

            <parent link="tibia_${index}_link" />
            <child link="femur_${index}_link" />
            <origin xyz="0 110e-3 0" rpy="${-8.7 * pi / 180} 0 0"/>
            <limit lower="${-pi / 2}" upper="${pi / 2}" effort="2.941995" velocity="${2 * pi / 1.2}"/>
         </joint>

         <joint name="femur_to_endpoint_${index}_joint" type="fixed">

            <parent link="femur_${index}_link" />
            <child link="endpoint_${index}_link" />
            <origin xyz="0 -25.7e-3 168e-3" rpy="${8.7 * pi / 180} 0 0"/>
         </joint>
    </xacro:macro>

    <xacro:leg index="fr" angle="${pi / 6}"/>
    <xacro:leg index="cr" angle="${pi / 2}"/>
    <xacro:leg index="br" angle="${5 * pi / 6}"/>
    <xacro:leg index="bl" angle="${7 * pi / 6}"/>
    <xacro:leg index="cl" angle="${3 * pi / 2}"/>
    <xacro:leg index="fl" angle="${11 * pi / 6}"/>
   

</robot>