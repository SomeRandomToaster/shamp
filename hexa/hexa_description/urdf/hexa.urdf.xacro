<?xml version="1.0"?>
<robot name="hexa" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="use_mock_hardware" default="false" />

    <xacro:include filename="materials.xacro" />
    <xacro:include filename="hexa_base.xacro" />
    <xacro:include filename="hexa_base.ros2_control.xacro" />

    <xacro:hexa_ros2_control use_mock_hardware="$(arg use_mock_hardware)"/>

</robot>